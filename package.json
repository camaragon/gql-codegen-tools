{
  "name": "gql-codegen-tools",
  "version": "1.0.0",
  "description": "CLI tool for generating TypeScript mock factories and MSW handlers from GraphQL fragments and operations",
  "main": "dist/cli.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && esbuild src/cli.ts --bundle --platform=node --outdir=dist --format=cjs",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": {
    "gql-codegen-tools": "./bin/gql-codegen-tools.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "graphql",
    "codegen",
    "typescript",
    "mock",
    "factory",
    "msw",
    "testing",
    "cli"
  ],
  "author": "Cameron Aragon <caragon4695@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camaragon/gql-codegen-tools.git"
  },
  "bugs": {
    "url": "https://github.com/camaragon/gql-codegen-tools/issues"
  },
  "homepage": "https://github.com/camaragon/gql-codegen-tools#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "type": "commonjs",
  "dependencies": {
    "fast-glob": "^3.3.3",
    "graphql": "^16.11.0",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^24.0.10",
    "esbuild": "^0.25.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
